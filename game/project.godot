; DEAD BREATH - configuração do projeto Godot 4.7.2 (F1-003).
; Decisões: ENGINE_DECISION.md (Forward+, GodotPhysics3D, 60 Hz) e
; SYSTEM_ARCHITECTURE §11 (pastas) / §11.1 (camadas de física e input map).

config_version=5

[application]

config/name="DEAD BREATH"
config/description="Survival horror psicológico em primeira pessoa."
run/main_scene="res://content/levels/sandbox_playable.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Log="*res://autoload/log.gd"
EventBus="*res://autoload/event_bus.gd"
Settings="*res://autoload/settings.gd"
SaveService="*res://autoload/save_service.gd"
GameState="*res://autoload/game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_property_access=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
slow_walk={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194328)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
crawl={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":90)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
use_item={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
debug_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="world_dynamic"
3d_physics/layer_3="player"
3d_physics/layer_4="enemy"
3d_physics/layer_5="interactable"
3d_physics/layer_6="hideable"
3d_physics/layer_7="vision_occluder"
3d_physics/layer_8="trigger"

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
